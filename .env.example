APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://affluena_api:affluena_api@localhost:5432/affluena_api?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
RUN_MIGRATIONS=true
RECURRING_SCHEDULER_ENABLED=true
RECURRING_SCHEDULER_INTERVAL=1m
RECURRING_SCHEDULER_BATCH_SIZE=20
CORS_ALLOWED_ORIGINS=http://localhost:5173
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@affluena.com
AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10
