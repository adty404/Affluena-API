APP_ENV=production
HTTP_ADDR=:8080
DATABASE_URL=postgres://affluena_api:CHANGE_THIS_DB_PASSWORD@postgres:5432/affluena_api?sslmode=disable
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
RUN_MIGRATIONS=true
RECURRING_SCHEDULER_ENABLED=true
RECURRING_SCHEDULER_INTERVAL=1m
RECURRING_SCHEDULER_BATCH_SIZE=20
CORS_ALLOWED_ORIGINS=https://your-domain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com
AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10
