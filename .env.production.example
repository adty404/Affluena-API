APP_ENV=production
HTTP_ADDR=:8080
# Database connection.
#  - Remote/managed DB over an untrusted network: use sslmode=require (or
#    verify-full with a CA). The app refuses to boot with sslmode=disable in
#    production by default.
#  - Postgres on the SAME trusted host / Docker network (the default compose
#    setup, where traffic never leaves the host): sslmode=disable is fine, but
#    you must explicitly opt in with ALLOW_INSECURE_DB=true below.
DATABASE_URL=postgres://affluena_api:CHANGE_THIS_DB_PASSWORD@postgres:5432/affluena_api?sslmode=disable
# Set true ONLY when the database is reachable solely over a trusted host/network
# (e.g. the bundled docker-compose postgres). Leave false/unset for remote DBs.
ALLOW_INSECURE_DB=true
# Generate a high-entropy secret, e.g.: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32+_CHAR_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
RUN_MIGRATIONS=true
RECURRING_SCHEDULER_ENABLED=true
RECURRING_SCHEDULER_INTERVAL=1m
RECURRING_SCHEDULER_BATCH_SIZE=20
# Notification scheduler: due reminders (H-3/H-1) + weekly cashflow summary.
# Sends are gated on notification_rules and de-duped, so a frequent tick is safe.
NOTIFICATION_SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_INTERVAL=1h
CORS_ALLOWED_ORIGINS=https://your-domain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com
AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10
