APP_ENV=production
HTTP_ADDR=:8080
# Use an encrypted DB connection in production (sslmode=require, or verify-full with a CA).
# The app refuses to start with sslmode=disable when APP_ENV=production.
DATABASE_URL=postgres://affluena_api:CHANGE_THIS_DB_PASSWORD@postgres:5432/affluena_api?sslmode=require
# Generate a high-entropy secret, e.g.: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32+_CHAR_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
RUN_MIGRATIONS=true
RECURRING_SCHEDULER_ENABLED=true
RECURRING_SCHEDULER_INTERVAL=1m
RECURRING_SCHEDULER_BATCH_SIZE=20
CORS_ALLOWED_ORIGINS=https://your-domain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com
AUTH_RATE_LIMIT_RPS=5
AUTH_RATE_LIMIT_BURST=10
